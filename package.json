{
  "name": "test-qti-player-web-component-react",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "description": "QTI 3 Test Runner Controller (React, web-component packaged)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:config && npm run build:wc",
    "build:config": "vite build --config vite.lib.config.ts",
    "build:wc": "node scripts/build-wc.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "npm run type-check",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@longsightgroup/qti3-core": "^0.10.2",
    "@longsightgroup/qti3-player": "^0.10.2",
    "@longsightgroup/qti3-player-react": "^0.10.2",
    "@project-sunbird/client-services": "^8.1.4",
    "@project-sunbird/telemetry-sdk": "^1.3.0",
    "jquery": "^3.7.1",
    "qti3-stimulus-player": "^0.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vue": "^2.6.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.1.0",
    "@testing-library/react": "14.0.0",
    "@types/jquery": "^3.5.34",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^22.1.0",
    "sass": "1.101.0",
    "typescript": "^5.3.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
